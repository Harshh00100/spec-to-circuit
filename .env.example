# Copy to .env and fill in. Never commit .env.
# The app reads these from real environment variables (it does not load .env itself).

# --- LLM endpoint (any OpenAI-compatible chat API) ---
# Default is local Ollama, which needs no key and costs nothing:
#   1. install Ollama, then:  ollama pull llama3.1:8b
#   2. set LLM_MODEL to the name shown by:  ollama list
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
# Not needed for localhost. Required for any remote provider.
LLM_API_KEY=
# Optional. Seconds to wait for one reply (default 120 local, 60 remote).
LLM_TIMEOUT_S=
# Optional. Set to 0 if a model/provider rejects response_format=json_object.
LLM_JSON_MODE=

# Nebius Token Factory is the original target. The old NEBIUS_API_KEY,
# NEBIUS_MODEL and NEBIUS_BASE_URL names still work as fallbacks.
# Docs: https://docs.tokenfactory.nebius.com/quickstart

# Optional: path to the ngspice binary if it is not on PATH
NGSPICE_BIN=
